# VeilPool local environment (testnet/mock only)
VEILPOOL_MODE=mock
VEILPOOL_ADMIN_TOKEN=dev-admin
DATABASE_URL=sqlite:///./veilpool.db

# MVP API auth (leave false for the local demo)
VEILPOOL_REQUIRE_AUTH=false
VEILPOOL_API_TOKEN=dev-api-token

# Web
VITE_API_BASE_URL=http://127.0.0.1:8000
# VITE_API_TOKEN=dev-api-token

# Local chain (Anvil, chain ID 31337 only)
ANVIL_RPC_URL=http://127.0.0.1:8545
ANVIL_CHAIN_ID=31337
VEILPOOL_CONTRACT_ADDRESS=
VEILPOOL_INDEXER_URL=http://127.0.0.1:8100
VEILPOOL_LOCAL_RPC_URL=http://127.0.0.1:8545
VEILPOOL_LOCAL_AUTO_DEPOSIT=false
VEILPOOL_LOCAL_FROM_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266

# Local-chain indexer (apps/indexer). Set VEILPOOL_ADDRESS after deployment.
VEILPOOL_ADDRESS=
INDEXER_DB=indexer.db
INDEXER_START_BLOCK=0
INDEXER_PORT=8100
INDEXER_ALLOWED_CHAIN_IDS=31337

# Never add a mainnet RPC or production key here.
