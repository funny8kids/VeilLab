# Base URL of the VeilPool API. The UI falls back to clearly labelled demo data
# when this endpoint is unreachable.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Optional local-development bearer token. When set, every API request gets
# "Authorization: Bearer <token>". This is a build-time value: it must not be a
# real token in a public production build, and it is never read from the URL,
# localStorage or a note.
# VITE_API_TOKEN=local-dev-token-only

# Set to "true" to generate circuit-compatible Poseidon note v2 in mock/demo
# mode too. Local Anvil mode always uses note v2. There is no browser prover
# yet, so this does not enable real ZK withdrawals.
# VITE_ZK_NOTES=true
