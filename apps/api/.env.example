# VeilPool API environment
#
# Two modes:
#   mock  - SQLite MockChain, default, six seeded pools, existing web demo
#   local - local Anvil chain + standalone indexer, three ETH pools, chain id 31337
# Mainnet and non-loopback URLs are rejected.

VEILPOOL_MODE=mock

# SQLite for local development. The file is created/seeded on startup.
DATABASE_URL=sqlite:///./veilpool.db

# Development-only admin token. Change it outside a local demo.
VEILPOOL_ADMIN_TOKEN=dev-admin

# Optional local-demo auth. Default false keeps the web demo unchanged.
# When true, POST /api/v1/local/deposits also requires the bearer token.
VEILPOOL_REQUIRE_AUTH=false
VEILPOOL_API_TOKEN=dev-api-token

# In-memory token buckets (per process). Set a limit to 0 to disable that scope.
VEILPOOL_RATE_LIMIT_ENABLED=true
VEILPOOL_RATE_LIMIT_WINDOW_SECONDS=60
VEILPOOL_RATE_LIMIT_DEPOSIT_INTENT=10
VEILPOOL_RATE_LIMIT_WITHDRAWAL_QUOTE=10
VEILPOOL_RATE_LIMIT_WITHDRAWAL_SUBMIT=5
VEILPOOL_RATE_LIMIT_COMPLIANCE=30
VEILPOOL_RATE_LIMIT_ADMIN=60
# Dev-only Anvil deposit bridge, default 5/min per caller.
VEILPOOL_RATE_LIMIT_LOCAL_DEPOSIT=5
# Dev-only Anvil withdrawal bridge, default 5/min per caller.
VEILPOOL_RATE_LIMIT_LOCAL_WITHDRAWAL=5
# Public local Merkle-path proxy, default 30/min per caller.
VEILPOOL_RATE_LIMIT_POOL_PATH=30

# Maximum request body size in bytes.
VEILPOOL_MAX_BODY_BYTES=65536

# Default lifetime for an approved/rejected manual compliance review.
VEILPOOL_REVIEW_DECISION_TTL_SECONDS=86400

# Sepolia in mock mode. Mainnet and unknown chain ids are rejected.
# In local mode this MUST be 31337 (Anvil).
VEILPOOL_CHAIN_ID=11155111

# ---------------------------------------------------------------------------
# Local Anvil mode
# ---------------------------------------------------------------------------
# VEILPOOL_MODE=local
# VEILPOOL_CHAIN_ID=31337
#
# Single deployed VeilPool address from contracts/script/Deploy.s.sol.
# Required in local mode.
# VEILPOOL_CONTRACT_ADDRESS=0x...
#
# Both URLs must be loopback (127.0.0.1, localhost or ::1) in local mode.
# VEILPOOL_INDEXER_URL=http://127.0.0.1:8100
# VEILPOOL_INDEXER_TIMEOUT_SECONDS=3
# VEILPOOL_LOCAL_RPC_URL=http://127.0.0.1:8545
#
# Anvil account 0. Anvil owns this unlocked PUBLIC test key; the API never
# accepts or stores a private key.
# VEILPOOL_LOCAL_FROM_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
#
# false: return 409 LOCAL_DEPOSIT_DISABLED with calldata for the user wallet.
# true:  send eth_sendTransaction from the Anvil account above.
# VEILPOOL_LOCAL_AUTO_DEPOSIT=false
# VEILPOOL_LOCAL_DEPOSIT_TIMEOUT_SECONDS=15
#
# Dev-only withdrawal bridge. Default false: return 409
# LOCAL_WITHDRAWAL_DISABLED with calldata for the caller's own wallet.
# true: send withdraw(...) from the same unlocked Anvil account. No private
# key is ever accepted or stored. This is not a production relayer.
# VEILPOOL_LOCAL_AUTO_WITHDRAW=false
# VEILPOOL_LOCAL_WITHDRAWAL_TIMEOUT_SECONDS=20
#
# Verifier label for local mode:
#   mock    - existing MockVerifier deployment (shape-only, no ZK)
#   groth16 - local VeilPoolPoseidon + Groth16VerifierAdapter deployment
#             (development zkey, unaudited; never a production claim)
# Unknown values fail closed at startup.
# VEILPOOL_LOCAL_VERIFIER_KIND=mock
#
# Local spike only: override the seeded ETH pool maturity to match the deployed
# contract. DeployPoseidon.s.sol creates maturity-0 pools for immediate proof
# testing. This is not a product default.
# VEILPOOL_LOCAL_MATURITY_SECONDS=0
#
# Use a separate database for local mode so mock rows are not mixed in.
# DATABASE_URL=sqlite:///./veilpool-local.db
#

# Decision/quote/intent lifetimes in seconds.
VEILPOOL_INTENT_TTL_SECONDS=600
VEILPOOL_QUOTE_TTL_SECONDS=300
VEILPOOL_COMPLIANCE_TTL_SECONDS=300

# Number of recent Merkle roots accepted for withdrawal proofs.
VEILPOOL_ROOT_WINDOW_SIZE=20

# Salt used when hashing addresses for the mock compliance table.
VEILPOOL_COMPLIANCE_HASH_SALT=veilpool-dev-salt

# Mock chain starting block.
VEILPOOL_MOCK_START_BLOCK=6000000

# Optional test override: force every seeded pool to this maturity (seconds).
# Leave unset to use the per-pool values from the docs.
# VEILPOOL_MOCK_MATURITY_SECONDS=0
